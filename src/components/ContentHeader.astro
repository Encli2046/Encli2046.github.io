---
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags: string[];
  sourceType: string;
}

const { title, description, date, category, tags, sourceType } = Astro.props;
---

<header>
  <p class="eyebrow">{category} / {sourceType} / {formatDate(date)}</p>
  <h1>{title}</h1>
  <p class="lead">{description}</p>
  {
    tags.length > 0 && (
      <div class="tag-list">
        {tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    )
  }
</header>
