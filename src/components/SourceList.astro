---
import { formatDate } from '../lib/content';

interface Source {
  title: string;
  url: string;
  publisher: string;
  accessed: Date;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <aside class="source-list" aria-labelledby="sources-title">
      <h2 id="sources-title">资料来源</h2>
      <ol>
        {sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
            <div class="source-meta">
              {source.publisher} · 访问于 {formatDate(source.accessed)}
            </div>
          </li>
        ))}
      </ol>
    </aside>
  )
}
