---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize, plainify } from "@/lib/utils/textConverter";
import dateFormat from "@/lib/utils/dateFormat";

export async function getStaticPaths() {
  const allCats = [
    ...(await getTaxonomy("posts", "categories")),
    ...(await getTaxonomy("briefs", "categories")),
    ...(await getTaxonomy("notes", "categories")),
    ...(await getTaxonomy("timeline", "categories")),
  ];
  return [...new Set(allCats)].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;

const posts = await getSinglePage("posts");
const briefs = await getSinglePage("briefs");
const notes = await getSinglePage("notes");
const timeline = await getSinglePage("timeline");

const allEntries = sortByDate([
  ...taxonomyFilter(posts, "categories", category!).map((e: any) => ({ ...e, _url: `/blog/${e.id}` })),
  ...taxonomyFilter(briefs, "categories", category!).map((e: any) => ({ ...e, _url: `/briefs/${e.id}` })),
  ...taxonomyFilter(notes, "categories", category!).map((e: any) => ({ ...e, _url: `/notes/${e.id}` })),
  ...taxonomyFilter(timeline, "categories", category!).map((e: any) => ({ ...e, _url: `/timeline/${e.id}` })),
]);

const title = humanize(category || "");
---

<Base title={title || "Category"}>
  <div class="section">
    <div class="container">
      <p class="text-center text-2xl mb-4">分类筛选</p>
      <h1 class="h2 mb-16 text-center text-primary">{title}</h1>
      <div class="row gy-5 gx-4 justify-center">
        {allEntries.map((entry: any) => (
          <div class="col-12 sm:col-6">
            <ul class="mt-6 mb-4 flex flex-wrap items-center text-text">
              <li class="mr-5 flex items-center flex-wrap font-medium">
                {dateFormat(entry.data.date)}
              </li>
            </ul>
            <h3 class="mb-4">
              <a href={entry._url} class="block hover:text-primary transition duration-300">
                {entry.data.title}
              </a>
            </h3>
            <p class="text-text line-clamp-2">{plainify(entry.body ?? "")}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
